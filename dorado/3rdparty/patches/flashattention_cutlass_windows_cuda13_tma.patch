+#if defined(_WIN32) && defined(__CUDACC__) && (__CUDACC_VER_MAJOR__ >= 13)
+#define CUTE_SM90_WINDOWS_CUDA13_TMA_PARAM_WORKAROUND 1
+#else
+#define CUTE_SM90_WINDOWS_CUDA13_TMA_PARAM_WORKAROUND 0
+#endif
+
+namespace detail {
+
+CUTE_HOST_DEVICE
+void
+copy_tma_descriptor_bytes(unsigned char* dst, unsigned char const* src) {
+  for (int i = 0; i < sizeof(TmaDescriptor); ++i) {
+    dst[i] = src[i];
+  }
+}
+
+#if CUTE_SM90_WINDOWS_CUDA13_TMA_PARAM_WORKAROUND
+struct PackedTmaDescriptor {
+  alignas(16) unsigned char bytes[sizeof(TmaDescriptor)];
+
+  CUTE_HOST_DEVICE constexpr
+  PackedTmaDescriptor() : bytes{} {}
+
+  CUTE_HOST_DEVICE
+  PackedTmaDescriptor(const TmaDescriptor& desc) {
+    copy_tma_descriptor_bytes(bytes, reinterpret_cast<unsigned char const*>(&desc));
+  }
+};
+
+static_assert(sizeof(PackedTmaDescriptor) == sizeof(TmaDescriptor), "Packed TMA descriptor must preserve descriptor size.");
+
+using TmaDescriptorParamStorage = PackedTmaDescriptor;
+
+struct MaterializedTmaDescriptor {
+  TmaDescriptor desc;
+
+  CUTE_HOST_DEVICE explicit
+  MaterializedTmaDescriptor(unsigned char const* src) {
+    copy_tma_descriptor_bytes(reinterpret_cast<unsigned char*>(&desc), src);
+  }
+
+  CUTE_HOST_DEVICE
+  TmaDescriptor const*
+  get() const {
+    return &desc;
+  }
+};
+#else
+using TmaDescriptorParamStorage = TmaDescriptor;
+#endif
+
+} // namespace detail
+
+#if CUTE_SM90_WINDOWS_CUDA13_TMA_PARAM_WORKAROUND
